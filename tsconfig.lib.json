{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist-lib",
    "rootDir": "src/registry/tree",
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src/registry/tree/tree.tsx", "src/registry/tree/use-tree.ts", "src/registry/tree/types.ts"]
}
