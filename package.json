{
  "name": "tree-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "An accessible, zero-dependency tree view for shadcn/ui. Install with the shadcn CLI, own the code.",
  "license": "MIT",
  "keywords": [
    "react",
    "shadcn",
    "registry",
    "tree",
    "tree-view",
    "file-tree",
    "accessible",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/tree-ui.git"
  },
  "homepage": "https://github.com/OWNER/tree-ui",
  "bugs": {
    "url": "https://github.com/OWNER/tree-ui/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run registry:build && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/check-registry.mjs",
    "registry:smoke": "node scripts/install-smoke.mjs",
    "set-repo": "node scripts/set-repo.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run registry:check && npm run registry:smoke"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
